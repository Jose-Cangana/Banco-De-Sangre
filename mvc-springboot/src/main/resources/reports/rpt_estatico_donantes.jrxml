<?xml version="1.0" encoding="UTF-8"?>
<!-- REPORTE ESTATICO: listado general de donantes. No recibe parametros de filtro; la consulta y el diseno son fijos. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_estatico_donantes" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="794" leftMargin="24" rightMargin="24" topMargin="24" bottomMargin="24" whenNoDataType="NoDataSection" isSummaryWithPageHeaderAndFooter="true">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="BancoSangrePostgreSQL"/>
	<style name="Base" isDefault="true" forecolor="#12161F" fontName="DejaVu Sans" fontSize="8"/>
	<style name="Fila" mode="Opaque" backcolor="#FFFFFF">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F7F8FA"/>
		</conditionalStyle>
	</style>
	<parameter name="LOGO" class="java.lang.String">
		<parameterDescription><![CDATA[Ruta del logo (en la app: reportes/img/logo-reporte.png)]]></parameterDescription>
		<defaultValueExpression><![CDATA["reports/img/logo-reporte.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="USUARIO" class="java.lang.String">
		<parameterDescription><![CDATA[Usuario que genera el reporte]]></parameterDescription>
		<defaultValueExpression><![CDATA["Sistema"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT dni,
       concat_ws(' ', NULLIF(TRIM(nombres), ''), NULLIF(TRIM(apellidos), '')) AS donante,
       COALESCE(grupo_abo::text || CASE factor_rh WHEN 'positivo' THEN '+' ELSE '-' END, 'Sin confirmar') AS grupo,
       sexo::text AS sexo,
       tipo_donacion::text AS tipo_donacion,
       total_donaciones,
       ultima_donacion,
       CASE WHEN apto THEN 'Sí' ELSE 'No' END AS apto,
       CASE WHEN diferido THEN 'Diferido' ELSE 'Activo' END AS estado,
       campana
FROM donantes
ORDER BY apellidos, nombres]]>
	</queryString>
	<field name="dni" class="java.lang.String"/>
	<field name="donante" class="java.lang.String"/>
	<field name="grupo" class="java.lang.String"/>
	<field name="sexo" class="java.lang.String"/>
	<field name="tipo_donacion" class="java.lang.String"/>
	<field name="total_donaciones" class="java.lang.Integer"/>
	<field name="ultima_donacion" class="java.sql.Date"/>
	<field name="apto" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="campana" class="java.lang.String"/>
	<variable name="TOTAL" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[1]]></variableExpression>
	</variable>
	<variable name="APTOS" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["Sí".equals($F{apto}) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="DIFERIDOS" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["Diferido".equals($F{estado}) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="DONACIONES" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{total_donaciones} == null ? 0 : $F{total_donaciones}]]></variableExpression>
	</variable>
