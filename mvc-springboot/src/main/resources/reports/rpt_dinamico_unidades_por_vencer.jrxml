<?xml version="1.0" encoding="UTF-8"?>
<!-- REPORTE DINAMICO: unidades por vencer (FEFO). Parametros: DIAS (entero), GRUPO_ABO (TODOS|A|B|AB|O). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_dinamico_unidades_por_vencer" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="794" leftMargin="24" rightMargin="24" topMargin="24" bottomMargin="24" whenNoDataType="NoDataSection" isSummaryWithPageHeaderAndFooter="true">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="BancoSangrePostgreSQL"/>
	<style name="Base" isDefault="true" forecolor="#12161F" fontName="DejaVu Sans" fontSize="8"/>
	<style name="Fila" mode="Opaque" backcolor="#FFFFFF">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F7F8FA"/>
		</conditionalStyle>
	</style>
	<style name="Dias" forecolor="#12161F" isBold="true">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{dias_restantes} < 0]]></conditionExpression>
			<style forecolor="#9E1B1B" isBold="true"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{dias_restantes} >= 0 && $F{dias_restantes} <= 7]]></conditionExpression>
			<style forecolor="#A9760A" isBold="true"/>
		</conditionalStyle>
	</style>
	<parameter name="LOGO" class="java.lang.String">
		<parameterDescription><![CDATA[Ruta del logo (en la app: reportes/img/logo-reporte.png)]]></parameterDescription>
		<defaultValueExpression><![CDATA["img/logo-reporte.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="USUARIO" class="java.lang.String">
		<parameterDescription><![CDATA[Usuario que genera el reporte]]></parameterDescription>
		<defaultValueExpression><![CDATA["Sistema"]]></defaultValueExpression>
	</parameter>
	<parameter name="DIAS" class="java.lang.Integer">
		<parameterDescription><![CDATA[Horizonte en dias (0 = solo vencidas hasta hoy)]]></parameterDescription>
		<defaultValueExpression><![CDATA[Integer.valueOf(30)]]></defaultValueExpression>
	</parameter>
	<parameter name="GRUPO_ABO" class="java.lang.String">
		<parameterDescription><![CDATA[TODOS, A, B, AB u O]]></parameterDescription>
		<defaultValueExpression><![CDATA["TODOS"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT u.din,
       u.grupo_abo::text || CASE u.factor_rh WHEN 'positivo' THEN '+' ELSE '-' END AS grupo,
       u.fecha_extraccion,
       u.fecha_vencimiento,
       (u.fecha_vencimiento - current_date) AS dias_restantes,
       u.estado::text AS estado
FROM unidades_sangre u
WHERE u.estado::text NOT IN ('despachado', 'incinerado', 'fraccionado')
  AND u.fecha_vencimiento <= current_date + $P{DIAS}
  AND (CAST($P{GRUPO_ABO} AS text) = 'TODOS' OR u.grupo_abo::text = CAST($P{GRUPO_ABO} AS text))
ORDER BY u.fecha_vencimiento, u.din]]>
	</queryString>
	<field name="din" class="java.lang.String"/>
	<field name="grupo" class="java.lang.String"/>
	<field name="fecha_extraccion" class="java.sql.Timestamp"/>
	<field name="fecha_vencimiento" class="java.sql.Date"/>
	<field name="dias_restantes" class="java.lang.Integer"/>
	<field name="estado" class="java.lang.String"/>
	<variable name="TOTAL" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[1]]></variableExpression>
	</variable>
	<variable name="VENCIDAS" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{dias_restantes} < 0 ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="CRITICAS" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{dias_restantes} >= 0 && $F{dias_restantes} <= 7) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="VIGENTES" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{dias_restantes} > 7 ? 1 : 0]]></variableExpression>
	</variable>
