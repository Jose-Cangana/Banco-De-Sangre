<?xml version="1.0" encoding="UTF-8"?>
<!-- REPORTE DINAMICO: solicitudes transfusionales. Parametros: FECHA_INICIO, FECHA_FIN, PRIORIDAD (TODAS|rutina|urgente|emergencia). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_dinamico_solicitudes" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="794" leftMargin="24" rightMargin="24" topMargin="24" bottomMargin="24" whenNoDataType="NoDataSection" isSummaryWithPageHeaderAndFooter="true">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="BancoSangrePostgreSQL"/>
	<style name="Base" isDefault="true" forecolor="#12161F" fontName="DejaVu Sans" fontSize="8"/>
	<style name="Fila" mode="Opaque" backcolor="#FFFFFF">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F7F8FA"/>
		</conditionalStyle>
	</style>
	<parameter name="LOGO" class="java.lang.String">
		<parameterDescription><![CDATA[Ruta del logo (en la app: reportes/img/logo-reporte.png)]]></parameterDescription>
		<defaultValueExpression><![CDATA["reports/img/logo-reporte.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="USUARIO" class="java.lang.String">
		<parameterDescription><![CDATA[Usuario que genera el reporte]]></parameterDescription>
		<defaultValueExpression><![CDATA["Sistema"]]></defaultValueExpression>
	</parameter>
	<parameter name="FECHA_INICIO" class="java.util.Date">
		<parameterDescription><![CDATA[Fecha inicial del periodo]]></parameterDescription>
		<defaultValueExpression><![CDATA[new java.text.SimpleDateFormat("yyyy-MM-dd").parse("2026-01-01")]]></defaultValueExpression>
	</parameter>
	<parameter name="FECHA_FIN" class="java.util.Date">
		<parameterDescription><![CDATA[Fecha final del periodo]]></parameterDescription>
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="PRIORIDAD" class="java.lang.String">
		<parameterDescription><![CDATA[TODAS, rutina, urgente o emergencia]]></parameterDescription>
		<defaultValueExpression><![CDATA["TODAS"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT s.codigo,
       s.creado_en::date AS fecha,
       p.nombres AS paciente,
       p.historia_clinica,
       s.servicio,
       s.diagnostico_texto AS diagnostico,
       s.prioridad::text AS prioridad,
       s.estado,
       u.apellidos || ', ' || u.nombres AS medico
FROM solicitudes_transfusionales s
JOIN pacientes p ON p.id = s.paciente_id
JOIN usuarios u ON u.id = s.medico_id
WHERE s.creado_en::date BETWEEN CAST($P{FECHA_INICIO} AS date) AND CAST($P{FECHA_FIN} AS date)
  AND (CAST($P{PRIORIDAD} AS text) = 'TODAS' OR s.prioridad::text = CAST($P{PRIORIDAD} AS text))
ORDER BY s.creado_en, s.codigo]]>
	</queryString>
	<field name="codigo" class="java.lang.String"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="paciente" class="java.lang.String"/>
	<field name="historia_clinica" class="java.lang.String"/>
	<field name="servicio" class="java.lang.String"/>
	<field name="diagnostico" class="java.lang.String"/>
	<field name="prioridad" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="medico" class="java.lang.String"/>
	<variable name="TOTAL" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[1]]></variableExpression>
	</variable>
	<variable name="URGENTES" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["rutina".equals($F{prioridad}) ? 0 : 1]]></variableExpression>
	</variable>
	<variable name="PENDIENTES" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["pendiente".equals($F{estado}) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="COMPATIBLES" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["compatible".equals($F{estado}) ? 1 : 0]]></variableExpression>
	</variable>
