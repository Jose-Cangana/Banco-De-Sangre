	<queryString language="SQL"><![CDATA[SELECT din_derivado c1, tipo_a_producto(tipo) c2, to_char(fecha_vencimiento,'DD/MM/YYYY') c3,
 initcap(estado::text) c4, coalesce(motivo_descarte,'—') c5 FROM hemocomponentes
 WHERE estado IN ('vencido','incinerado') ORDER BY fecha_vencimiento,din_derivado]]></queryString>
	<field name="c1" class="java.lang.String"/>
	<field name="c2" class="java.lang.String"/>
	<field name="c3" class="java.lang.String"/>
	<field name="c4" class="java.lang.String"/>
	<field name="c5" class="java.lang.String"/>
	<variable name="TOTAL" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[1]]></variableExpression></variable>
	<variable name="URGENTES" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA["Incinerado".equals($F{c4}) ? 1 : 0]]></variableExpression></variable>
	<variable name="PENDIENTES" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA["Vencido".equals($F{c4}) ? 1 : 0]]></variableExpression></variable>
	<variable name="COMPATIBLES" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA["—".equals($F{c5}) ? 0 : 1]]></variableExpression></variable>
