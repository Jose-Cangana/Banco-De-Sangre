<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_dinamico_operacional_mensual" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="794" leftMargin="24" rightMargin="24" topMargin="24" bottomMargin="24" whenNoDataType="NoDataSection" isSummaryWithPageHeaderAndFooter="true">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="BancoSangrePostgreSQL"/>
	<style name="Base" isDefault="true" forecolor="#12161F" fontName="DejaVu Sans" fontSize="8"/>
	<style name="Fila" mode="Opaque" backcolor="#FFFFFF">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F7F8FA"/>
		</conditionalStyle>
	</style>
	<parameter name="LOGO" class="java.lang.String">
		<parameterDescription><![CDATA[Ruta del logo (en la app: reportes/img/logo-reporte.png)]]></parameterDescription>
		<defaultValueExpression><![CDATA["img/logo-reporte.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="USUARIO" class="java.lang.String">
		<parameterDescription><![CDATA[Usuario que genera el reporte]]></parameterDescription>
		<defaultValueExpression><![CDATA["Sistema"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL"><![CDATA[WITH movimientos AS (
 SELECT fecha_extraccion::date dia, 1 donaciones, 0 componentes, 0 entregas FROM unidades_sangre WHERE fecha_extraccion >= date_trunc('month', current_date) AND fecha_extraccion < date_trunc('month', current_date) + interval '1 month'
 UNION ALL SELECT creado_en::date, 0, 1, 0 FROM hemocomponentes WHERE creado_en >= date_trunc('month', current_date) AND creado_en < date_trunc('month', current_date) + interval '1 month'
 UNION ALL SELECT fecha_despacho::date, 0, 0, 1 FROM detalle_despachos WHERE fecha_despacho >= date_trunc('month', current_date) AND fecha_despacho < date_trunc('month', current_date) + interval '1 month'
)
SELECT to_char(dia,'DD/MM/YYYY') c1, sum(donaciones)::text c2, sum(componentes)::text c3, sum(entregas)::text c4 FROM movimientos GROUP BY dia ORDER BY dia]]></queryString>
	<field name="c1" class="java.lang.String"/>
	<field name="c2" class="java.lang.String"/>
	<field name="c3" class="java.lang.String"/>
	<field name="c4" class="java.lang.String"/>
	<variable name="TOTAL" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[1]]></variableExpression></variable>
	<variable name="URGENTES" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[Integer.valueOf($F{c2})]]></variableExpression></variable>
	<variable name="PENDIENTES" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[Integer.valueOf($F{c3})]]></variableExpression></variable>
	<variable name="COMPATIBLES" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[Integer.valueOf($F{c4})]]></variableExpression></variable>
