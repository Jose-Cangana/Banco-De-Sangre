	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="BancoSangrePostgreSQL"/>
	<style name="Base" isDefault="true" forecolor="#12161F" fontName="DejaVu Sans" fontSize="8"/>
	<style name="Fila" mode="Opaque" backcolor="#FFFFFF">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F7F8FA"/>
		</conditionalStyle>
	</style>
	<parameter name="LOGO" class="java.lang.String">
		<parameterDescription><![CDATA[Ruta del logo (en la app: reportes/img/logo-reporte.png)]]></parameterDescription>
		<defaultValueExpression><![CDATA["reports/img/logo-reporte.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="USUARIO" class="java.lang.String">
		<parameterDescription><![CDATA[Usuario que genera el reporte]]></parameterDescription>
		<defaultValueExpression><![CDATA["Sistema"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL"><![CDATA[SELECT m.marcador c1, resultado_a_texto(m.resultado) c2, count(*)::text c3,
 round(100.0 * count(*) / sum(count(*)) OVER (PARTITION BY m.marcador), 1)::text || '%' c4
 FROM detalle_tamizaje t CROSS JOIN LATERAL (VALUES ('VIH 1/2',t.vih),('Hepatitis B',t.hepatitis_b),('Hepatitis C',t.hepatitis_c),('Sífilis',t.sifilis),('Chagas',t.chagas),('HTLV I/II',t.htlv)) m(marcador,resultado)
 GROUP BY m.marcador,m.resultado ORDER BY m.marcador,m.resultado]]></queryString>
	<field name="c1" class="java.lang.String"/>
	<field name="c2" class="java.lang.String"/>
	<field name="c3" class="java.lang.String"/>
	<field name="c4" class="java.lang.String"/>
	<variable name="TOTAL" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[Integer.valueOf($F{c3})]]></variableExpression></variable>
	<variable name="URGENTES" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA["Reactivo".equals($F{c2}) ? Integer.valueOf($F{c3}) : 0]]></variableExpression></variable>
	<variable name="PENDIENTES" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA["Indeterminado".equals($F{c2}) ? Integer.valueOf($F{c3}) : 0]]></variableExpression></variable>
	<variable name="COMPATIBLES" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA["No reactivo".equals($F{c2}) ? Integer.valueOf($F{c3}) : 0]]></variableExpression></variable>
